# Preferred: Neon Auth + Data API (same as ks-sw-dashboard_test).
# Public HTTPS DB URL — no user, password, or query string.
# Example (working test/prod Neon):
# VITE_NEON_URL=https://ep-divine-meadow-azqo19a2.c-3.ap-southeast-1.aws.neon.tech/neondb
VITE_NEON_URL=

# Legacy Supabase (only if VITE_NEON_URL is empty)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Test Reports → GitHub Contents upload (optional; prefer session paste in UI).
# Fine-grained PAT with Contents: Write on this repo only. See docs/test-reports-github-upload.md.
# VITE_GH_UPLOAD_TOKEN=
# VITE_GITHUB_REPO=chungalbert/ks-sw-dashboard
# VITE_GITHUB_BRANCH=main

